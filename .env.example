# Hundo — copy to .env and fill in. .env is git-ignored.
# On Render/Vercel these are set in the platform dashboard (see DEPLOY.md).
# Every key config.py reads is listed here. Commented keys are OPTIONAL; the
# value shown is the built-in default.

# ── Required secrets ──────────────────────────────────────────────────────────
STEAM_API_KEY=your_steam_web_api_key   # https://steamcommunity.com/dev/apikey
LLM_API_KEY=your_deepseek_api_key      # DeepSeek key (OpenAI-compatible API)
TAVILY_API_KEY=your_tavily_api_key     # how-to / time-to-complete web search

# ── Wiring ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173     # comma-separated; prod: your Vercel domain
# STEAM_ID=                            # default profile when a request passes none (optional)
# Steam OpenID sign-in. PUBLIC_API_URL = this API's own public URL (for the OpenID
# return; required behind a proxy). FRONTEND_URL defaults to CORS_ORIGINS[0].
# PUBLIC_API_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173

# ── LLM ───────────────────────────────────────────────────────────────────────
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro      # planner/code-gen, roadmap, chart spec
# DEEPSEEK_MODEL_FLASH=deepseek-v4-flash  # finalize, verify, triage, memory
# LLM_MAX_TOKENS=4096                     # global max_tokens ceiling per call

# ── Sandbox (LLM-generated code) ──────────────────────────────────────────────
# EXEC_TIMEOUT_SECONDS=10   # hard kill; Render free tier (0.1 CPU) needs 30
# EXEC_MEMORY_MB=2048       # RLIMIT_AS (VIRTUAL memory, POSIX only) — keep >= 2048

# ── Public demo profile (landing page) ───────────────────────────────────────
# A real, PUBLIC SteamID64 that visitors can explore without signing in. The
# browser only ever sees the alias "demo" — the API maps it and returns a
# generic name/avatar, so the underlying account stays anonymous. Unset = the
# demo button is hidden.
# DEMO_STEAM_ID=7656119...
# DEMO_DISPLAY_NAME=Demo Collector
# DEMO_ASK_PER_DAY=30        # agent questions/day across ALL demo visitors
#                            # (cached + fast-path answers are free, never counted); 0 = no cap

# ── Agent engines ─────────────────────────────────────────────────────────────
# ROADMAP_ENGINE=deterministic   # deterministic (default, ~1s) | codegen (the
#                                # agent writes + sandboxes pandas — demo/A-B)

# ── Rate limits (per client IP) ───────────────────────────────────────────────
# RATE_LIMIT_ASK_PER_MIN=15
# RATE_LIMIT_ASK_PER_DAY=150
# RATE_LIMIT_SESSION_PER_MIN=10
# RATE_LIMIT_CHART_PER_MIN=10
# RATE_LIMIT_CHART_PER_DAY=100
# RATE_LIMIT_READ_PER_MIN=30       # /library, /popular, /memory
# RATE_LIMIT_STATUS_PER_MIN=90     # /session/status (polled ~40/min during a build)

# ── Request caps (/ask) ───────────────────────────────────────────────────────
# MAX_QUESTION_CHARS=1000
# MAX_HISTORY_TURNS=6
# MAX_HISTORY_ANSWER_CHARS=600

# ── Caches ────────────────────────────────────────────────────────────────────
# ANSWER_CACHE_TTL_SECONDS=21600   # repeat-question cache (Redis); 0 disables
# SEARCH_CACHE_TTL_DAYS=14         # shared Tavily / Steam-store cache (per game, not per user)
# CHART_TTL_HOURS=6                # legacy chart PNG sweep (charts are client-rendered since 19.2)
# CHART_MAX_FILES=50

# ── Snapshot lifecycle ────────────────────────────────────────────────────────
# SNAPSHOT_LOCK_TTL=90      # build-lock TTL (heartbeat-refreshed while a build is alive)
# SNAPSHOT_WAIT_MAX=900     # max seconds a concurrent caller waits on another build
# SNAPSHOT_TTL_DAYS=30      # GC snapshots not rebuilt in this many days (needs the DB)

# ── Object storage + DB (Supabase) — prod only ────────────────────────────────
# Unset locally → charts/snapshots stay on disk and DB writes no-op.
# Both keys together enable Storage AND the lean Postgres (same project/creds).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key
# SUPABASE_BUCKET_CHARTS=hundo-charts          # public bucket
# SUPABASE_BUCKET_SNAPSHOTS=hundo-snapshots    # private bucket

# ── Redis (Upstash REST) — prod only ──────────────────────────────────────────
# Rate-limit counters, build-lock, build status, answer cache. Unset → in-memory
# fallback (single instance only).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_rest_token

# ── Observability (opt-in) ────────────────────────────────────────────────────
# HUNDO_TRACING=false        # "true" sends LangSmith traces (needs LANGSMITH_API_KEY)
# LANGSMITH_API_KEY=
